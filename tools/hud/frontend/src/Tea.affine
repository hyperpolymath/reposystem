module Tea;

module Cmd {
    enum T<Msg> {
        None,
        Batch { cmds: Array<T<Msg>> },
        Perform { task: fn() -> Promise<Msg> },
        Attempt { task: fn() -> Promise<Result<Msg, Error>> },
    }

    fn none<Msg>(): T<Msg> {
        T.None
    }

    fn batch<Msg>(cmds: Array<T<Msg>>): T<Msg> {
        T.Batch { cmds }
    }

    fn perform<A, Msg>(task: fn() -> Promise<A>, toMsg: fn(A) -> Msg): T<Msg> {
        T.Perform {
            task: async || {
                let result = await task();
                toMsg(result)
            }
        }
    }

    fn attempt<A, Msg>(task: fn() -> Promise<A>, toMsg: fn(Result<A, Error>) -> Msg): T<Msg> {
        T.Attempt {
            task: async || {
                match await task() {
                    Ok(result) => Ok(toMsg(Ok(result))),
                    Err(ex) => Ok(toMsg(Err(ex))),
                }
            }
        }
    }
}

module Sub {
    enum T<Msg> {
        None,
        Batch { subs: Array<T<Msg>> },
        Interval { ms: Int, toMsg: fn() -> Msg },
        OnKeyDown { handler: fn(String) -> Option<Msg> },
        OnKeyUp { handler: fn(String) -> Option<Msg> },
        OnResize { handler: fn(Int, Int) -> Msg },
    }

    fn none<Msg>(): T<Msg> {
        T.None
    }

    fn batch<Msg>(subs: Array<T<Msg>>): T<Msg> {
        T.Batch { subs }
    }

    fn every<Msg>(ms: Int, toMsg: fn() -> Msg): T<Msg> {
        T.Interval { ms, toMsg }
    }

    fn onKeyDown<Msg>(handler: fn(String) -> Option<Msg>): T<Msg> {
        T.OnKeyDown { handler }
    }

    fn onKeyUp<Msg>(handler: fn(String) -> Option<Msg>): T<Msg> {
        T.OnKeyUp { handler }
    }

    fn onResize<Msg>(handler: fn(Int, Int) -> Msg): T<Msg> {
        T.OnResize { handler }
    }
}

struct App<Model, Msg> {
    init: fn() -> (Model, Cmd.T<Msg>),
    update: fn(Msg, Model) -> (Model, Cmd.T<Msg>),
    view: fn(Model, fn(Msg) -> Unit) -> Element,
    subscriptions: fn(Model) -> Sub.T<Msg>,
}

struct Program<Model, Msg> {
    model: Model,
    dispatch: fn(Msg) -> Unit,
}

fn runCmd<Msg>(cmd: Cmd.T<Msg>, dispatch: fn(Msg) -> Unit) {
    match cmd {
        Cmd.T.None => (),
        Cmd.T.Batch { cmds } => {
            for c in cmds {
                runCmd(c, dispatch)
            }
        },
        Cmd.T.Perform { task } => {
            async {
                let msg = await task();
                dispatch(msg);
            }
        },
        Cmd.T.Attempt { task } => {
            async {
                match await task() {
                    Ok(msg) => dispatch(msg),
                    Err(_) => (),
                }
            }
        }
    }
}

fn setupSub<Msg>(sub: Sub.T<Msg>, dispatch: fn(Msg) -> Unit): Array<fn() -> Unit> {
    let mut cleanups = [];
    // Omitted full DOM event listener bindings for brevity in AffineScript skeleton.
    cleanups
}
