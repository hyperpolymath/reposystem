// Ported from ReScript to AffineScript via Harvard Engine Batch 3 (HUD)

module App;

import Tea;
import Api;
import SEOWidget;

struct Model {
    graph: Option<Api.GraphData>,
    error: Option<String>,
}

enum Msg {
    LoadGraph,
    GraphLoaded { result: Result<Api.GraphData, Error> },
}

fn init(): (Model, Tea.Cmd.T<Msg>) {
    (
        Model { graph: None, error: None },
        Tea.Cmd.perform(Api.fetchGraphData, |res| Msg.GraphLoaded { result: res })
    )
}

fn update(msg: Msg, model: Model): (Model, Tea.Cmd.T<Msg>) {
    match msg {
        Msg.LoadGraph => {
            (
                Model { graph: None, error: None, ..model },
                Tea.Cmd.perform(Api.fetchGraphData, |res| Msg.GraphLoaded { result: res })
            )
        },
        Msg.GraphLoaded { result } => {
            match result {
                Ok(data) => (Model { graph: Some(data), error: None }, Tea.Cmd.none()),
                Err(err) => (Model { graph: None, error: Some(err.toString()) }, Tea.Cmd.none()),
            }
        }
    }
}

fn view(model: Model, dispatch: fn(Msg) -> Unit): Element {
    <div>
        <h1>HUD Dashboard</h1>
        {match model.error {
            Some(e) => <div class="error">{e}</div>,
            None => <div />,
        }}
        {match model.graph {
            Some(g) => <div>Graph loaded with {g.nodes.length()} nodes.</div>,
            None => <div>Loading graph...</div>,
        }}
    </div>
}

fn subscriptions(model: Model): Tea.Sub.T<Msg> {
    Tea.Sub.none()
}
