module ForgeOpsModel;

enum ForgeCategory {
    Protection,
    CiCd,
    Secrets,
    Webhooks,
    Security,
}

enum Severity {
    Low,
    Medium,
    High,
    Critical,
}

struct PolicyConstraint {
    id: String,
    expression: String,
    category: ForgeCategory,
    enabled: Bool,
    severity: Severity,
    description: String,
    appliesTo: Option<String>,
}

struct ForgeSetting {
    id: String,
    value: String,
    defaultValue: String,
    category: ForgeCategory,
    forgeId: String,
    editable: Bool,
}

struct AuditResult {
    timestamp: String,
    repos: Array<String>,
    findings: Array<String>,
    passed: Int,
    failed: Int,
    warnings: Int,
    score: Float,
}

let DEFAULT_CONSTRAINTS: Array<PolicyConstraint> = [];
