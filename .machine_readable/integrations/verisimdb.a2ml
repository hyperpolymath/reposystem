# SPDX-License-Identifier: MPL-2.0
# VeriSimDB Feed — Cross-Repo Analytics Data Store
#
# Terminology note (reposystem issue #299): "hexad" in [feed-config] below was
# used generically for the emitted record shape. It never meant a six-element
# record. Upstream's named eight-modality contract is "Octad"; the
# number-agnostic term for a selected/configured group of modalities is
# "modality profile". See docs/VERISIMDB-MODALITY-PROFILE.adoc.
#
# The value is retained verbatim because it is stamped by an estate-wide
# generator (gitbot-fleet scripts/fix-missing-verisim-feed.sh writes the same
# `format = "hexad"` template), and because no emitter treats it as a schema
# discriminator: stateful-artefacts' verisimdb-feed bridge tags its records
# "feed-format": "provisional-v0" and states that no upstream modality-profile
# mapping exists. Retire the word in the generator, not here — a local rename
# would diverge and be re-stamped for the next repo that gets a feed.
# Retirement tracked at https://github.com/hyperpolymath/gitbot-fleet/issues/621

[integration]
name = "verisimdb"
type = "data-feed"
repository = "https://github.com/hyperpolymath/nextgen-databases"
data-store = "verisimdb-data"

[feed-config]
emit-scan-results = true
emit-build-metrics = true
emit-dependency-graph = true
# Legacy alias from the estate template, retained for compatibility. The
# emitted records are ordinary JSON documents — not octads, and not
# six-element hexads.
format = "hexad"
format-status = "legacy-generated-alias"
format-preferred-term = "modality-profile"
format-retire-in = "estate template: gitbot-fleet scripts/fix-missing-verisim-feed.sh (tracked: hyperpolymath/gitbot-fleet#621)"
destination = "verisimdb-data/feeds/"
