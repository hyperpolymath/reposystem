module Executor;

import Plan;
import IntegrationOps;
import Audit;

fn checkSafety(op: Plan.PlanOp, ctx: Plan.ExecutionContext): Result<Unit, String> {
    if op.risk == Plan.RiskLevel.Critical && !ctx.requireApproval {
        Err("Critical risk operations require approval")
    } else {
        Ok(())
    }
}

async fn executeOperation(op: Plan.PlanOp, ctx: Plan.ExecutionContext): Result<Plan.OpResult, String> {
    let safetyCheck = checkSafety(op, ctx);
    match safetyCheck {
        Err(err) => {
            Ok(Plan.OpResult {
                opId: op.id,
                status: Plan.ExecutionStatus.Failed { error: `Safety check failed: ${err}` },
                startedAt: Some(Date.now().toISOString()),
                completedAt: Some(Date.now().toISOString()),
                output: None,
                error: Some(err),
                metadata: Map.empty(),
            })
        },
        Ok(_) => {
            if ctx.dryRun {
                Ok(Plan.OpResult {
                    opId: op.id,
                    status: Plan.ExecutionStatus.Completed,
                    startedAt: Some(Date.now().toISOString()),
                    completedAt: Some(Date.now().toISOString()),
                    output: Some("Dry run completed successfully"),
                    error: None,
                    metadata: Map.empty(),
                })
            } else {
                IntegrationOps.executeIntegrationOp(op.opType, ctx).await
            }
        }
    }
}
