module BotDispatch;

import Plan;

enum BotType {
    Rhodibot,
    Echidnabot,
    Sustainabot,
    Glambot,
    Seambot,
    Finishbot,
}

enum BotCapability {
    FileModification,
    MetadataUpdate,
    SecurityScan,
    QualityAnalysis,
    DependencyCheck,
    StandardsEnforcement,
}

struct DispatchMessage {
    id: String,
    botType: BotType,
    operation: Plan.OperationType,
    repoId: Plan.RepoId,
    priority: Int,
    timeout: Int,
    retries: Int,
    metadata: Map<String, String>,
}

struct BotResponse {
    dispatchId: String,
    status: Plan.ExecutionStatus,
    output: Option<String>,
    findings: Array<String>,
    recommendations: Array<String>,
    metadata: Map<String, String>,
}

struct DispatchResult {
    dispatchId: String,
    botType: BotType,
    response: Option<BotResponse>,
    error: Option<String>,
    duration: Int,
}

enum DispatchStrategy {
    Sequential,
    Parallel,
    Throttled { maxConcurrent: Int },
}

fn botTypeToString(botType: BotType): String {
    match botType {
        BotType.Rhodibot => "rhodibot",
        BotType.Echidnabot => "echidnabot",
        BotType.Sustainabot => "sustainabot",
        BotType.Glambot => "glambot",
        BotType.Seambot => "seambot",
        BotType.Finishbot => "finishbot",
    }
}

fn botTypeFromString(str: String): Option<BotType> {
    match str {
        "rhodibot" => Some(BotType.Rhodibot),
        "echidnabot" => Some(BotType.Echidnabot),
        "sustainabot" => Some(BotType.Sustainabot),
        "glambot" => Some(BotType.Glambot),
        "seambot" => Some(BotType.Seambot),
        "finishbot" => Some(BotType.Finishbot),
        _ => None,
    }
}

fn selectBotForOperation(opType: Plan.OperationType): Option<BotType> {
    match opType {
        Plan.OperationType.BindSlot { .. } | Plan.OperationType.UnbindSlot { .. } => Some(BotType.Rhodibot),
        Plan.OperationType.UpdateMetadata { .. } => Some(BotType.Rhodibot),
        Plan.OperationType.CreateFile { .. } | Plan.OperationType.ModifyFile { .. } | Plan.OperationType.DeleteFile { .. } => Some(BotType.Rhodibot),
        Plan.OperationType.RunCommand { command, .. } => {
            match command {
                "git-seo" => Some(BotType.Glambot),
                "security-scan" => Some(BotType.Echidnabot),
                "dependency-check" => Some(BotType.Sustainabot),
                _ => Some(BotType.Rhodibot),
            }
        },
        Plan.OperationType.GitOperation { .. } => Some(BotType.Rhodibot),
        _ => None,
    }
}

fn hasCapability(botType: BotType, capability: BotCapability): Bool {
    match (botType, capability) {
        (BotType.Rhodibot, BotCapability.FileModification) | 
        (BotType.Rhodibot, BotCapability.MetadataUpdate) | 
        (BotType.Rhodibot, BotCapability.StandardsEnforcement) => true,
        (BotType.Echidnabot, BotCapability.SecurityScan) => true,
        (BotType.Sustainabot, BotCapability.DependencyCheck) => true,
        (BotType.Glambot, BotCapability.QualityAnalysis) => true,
        (BotType.Seambot, BotCapability.StandardsEnforcement) => true,
        (BotType.Finishbot, BotCapability.StandardsEnforcement) => true,
        _ => false,
    }
}
