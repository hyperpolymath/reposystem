module IntegrationValidator;

import Plan;

fn validateCreateScaffold(
    template: String,
    destination: String,
    repoName: String,
    metadata: Map<String, String>
): Result<Unit, String> {
    if template == "" {
        Err("template cannot be empty")
    } else if destination == "" {
        Err("destination cannot be empty")
    } else if repoName == "" {
        Err("repoName cannot be empty")
    } else {
        Ok(())
    }
}

fn validateUpdateMetadataFromSeo(
    repoPath: String,
    runAnalysis: Bool
): Result<Unit, String> {
    if repoPath == "" {
        Err("repoPath cannot be empty")
    } else {
        Ok(())
    }
}

fn validateRenderDocumentation(
    repoPath: String,
    templates: Array<String>
): Result<Unit, String> {
    if repoPath == "" {
        Err("repoPath cannot be empty")
    } else {
        Ok(())
    }
}

fn validateRegisterInReposystem(
    repoPath: String,
    repoName: String,
    aspects: Array<String>
): Result<Unit, String> {
    if repoPath == "" {
        Err("repoPath cannot be empty")
    } else if repoName == "" {
        Err("repoName cannot be empty")
    } else if aspects.length() == 0 {
        Err("aspects array cannot be empty")
    } else {
        Ok(())
    }
}

fn validateIntegrationOp(op: Plan.OperationType): Result<Unit, String> {
    match op {
        Plan.OperationType.CreateScaffold { template, destination, repoName, metadata } => {
            validateCreateScaffold(template, destination, repoName, metadata)
        },
        Plan.OperationType.UpdateMetadataFromSeo { repoPath, runAnalysis } => {
            validateUpdateMetadataFromSeo(repoPath, runAnalysis)
        },
        Plan.OperationType.RenderDocumentation { repoPath, templates } => {
            validateRenderDocumentation(repoPath, templates)
        },
        Plan.OperationType.RegisterInReposystem { repoPath, repoName, aspects, group: _ } => {
            validateRegisterInReposystem(repoPath, repoName, aspects)
        },
        _ => Err("Not an integration operation")
    }
}
