// Ported from ReScript to AffineScript via Harvard Engine Batch 2

module IntegrationOps;

import Plan;
import SeoUpdater;
import DocRenderer;

async fn executeCreateScaffold(
    template: String,
    destination: String,
    repoName: String,
    metadata: Map<String, String>,
    ctx: Plan.ExecutionContext
): Result<Plan.OpResult, String> {
    Console.log(`[CreateScaffold] ${template} -> ${destination} for ${repoName}`);

    Ok(Plan.OpResult {
        opId: "create-scaffold",
        status: Plan.ExecutionStatus.Skipped { reason: "CreateScaffold not implemented - requires template API" },
        startedAt: None,
        completedAt: None,
        output: None,
        error: None,
        metadata: Map.empty(),
    })
}

async fn executeUpdateMetadataFromSeo(
    repoPath: String,
    runAnalysis: Bool,
    ctx: Plan.ExecutionContext
): Result<Plan.OpResult, String> {
    await SeoUpdater.execute(repoPath, runAnalysis, ctx)
}

async fn executeRenderDocumentation(
    repoPath: String,
    templates: Array<String>,
    ctx: Plan.ExecutionContext
): Result<Plan.OpResult, String> {
    await DocRenderer.execute(repoPath, templates, ctx)
}

async fn executeRegisterInReposystem(
    repoPath: String,
    repoName: String,
    aspects: Array<String>,
    group: Option<String>,
    ctx: Plan.ExecutionContext
): Result<Plan.OpResult, String> {
    let aspectList = aspects.join(", ");
    let groupStr = match group {
        Some(g) => g,
        None => "none",
    };

    Console.log(`[RegisterInReposystem] name=${repoName}, aspects=${aspectList}, group=${groupStr}`);

    Ok(Plan.OpResult {
        opId: "register-reposystem",
        status: Plan.ExecutionStatus.Skipped { reason: "RegisterInReposystem not implemented - requires reposystem graph API" },
        startedAt: None,
        completedAt: None,
        output: None,
        error: None,
        metadata: Map.empty(),
    })
}

async fn executeIntegrationOp(
    op: Plan.OperationType,
    ctx: Plan.ExecutionContext
): Result<Plan.OpResult, String> {
    match op {
        Plan.OperationType.CreateScaffold { template, destination, repoName, metadata } => {
            await executeCreateScaffold(template, destination, repoName, metadata, ctx)
        },
        Plan.OperationType.UpdateMetadataFromSeo { repoPath, runAnalysis } => {
            await executeUpdateMetadataFromSeo(repoPath, runAnalysis, ctx)
        },
        Plan.OperationType.RenderDocumentation { repoPath, templates } => {
            await executeRenderDocumentation(repoPath, templates, ctx)
        },
        Plan.OperationType.RegisterInReposystem { repoPath, repoName, aspects, group } => {
            await executeRegisterInReposystem(repoPath, repoName, aspects, group, ctx)
        },
        _ => {
            Ok(Plan.OpResult {
                opId: "unknown",
                status: Plan.ExecutionStatus.Failed { error: "Not an integration operation" },
                startedAt: None,
                completedAt: None,
                output: None,
                error: Some("Not an integration operation"),
                metadata: Map.empty(),
            })
        }
    }
}
