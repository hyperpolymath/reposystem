module CLI;

import Plan;
import Executor;

enum Action {
    Validate { planPath: String },
    Execute { planPath: String, dryRun: Bool },
}

fn parseArgs(args: Array<String>): Result<Action, String> {
    if args.length() < 2 {
        Err("Not enough arguments. Usage: dispatcher <action> <plan.json>")
    } else {
        let actionStr = args[0];
        let planPath = args[1];

        match actionStr {
            "validate" => Ok(Action.Validate { planPath }),
            "execute" => {
                let dryRun = args.contains("--dry-run");
                Ok(Action.Execute { planPath, dryRun })
            },
            _ => Err(`Unknown action: ${actionStr}`)
        }
    }
}

async fn loadPlan(path: String): Result<Plan.Plan, String> {
    Console.log(`[CLI] Would load plan from: ${path}`);
    Err("Not implemented")
}

fn validatePlan(plan: Plan.Plan): Result<Unit, String> {
    Console.log(`[CLI] Validating plan: ${plan.id}`);
    Ok(())
}

async fn executePlan(planPath: String, dryRun: Bool): Result<Int, String> {
    match await loadPlan(planPath) {
        Err(err) => {
            Console.error(`Failed to load plan: ${err}`);
            Ok(1)
        },
        Ok(plan) => {
            match validatePlan(plan) {
                Err(err) => {
                    Console.error(`Validation failed: ${err}`);
                    Ok(1)
                },
                Ok(_) => {
                    Console.log(`Executing plan: ${plan.id} (dryRun=${dryRun})`);
                    Ok(0)
                }
            }
        }
    }
}

async fn main(args: Array<String>): Result<Int, String> {
    match parseArgs(args) {
        Err(err) => {
            Console.error(err);
            Ok(1)
        },
        Ok(action) => {
            match action {
                Action.Validate { planPath } => {
                    match await loadPlan(planPath) {
                        Err(err) => {
                            Console.error(`Failed to load plan: ${err}`);
                            Ok(1)
                        },
                        Ok(plan) => {
                            match validatePlan(plan) {
                                Ok(_) => Ok(0),
                                Err(err) => {
                                    Console.error(`Validation failed: ${err}`);
                                    Ok(1)
                                }
                            }
                        }
                    }
                },
                Action.Execute { planPath, dryRun } => {
                    executePlan(planPath, dryRun).await
                }
            }
        }
    }
}
