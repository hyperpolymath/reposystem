module Main;

import Plan;
import Audit;

enum PlanAction {
    Load { path: String },
    Show { planId: String },
    List,
    Validate { planId: String },
}

enum Command {
    Plan { action: PlanAction },
    Execute { planId: String, dryRun: Bool },
    Status { planId: Option<String> },
    Audit { filter: Audit.AuditFilter },
    Help,
    Version,
}

enum CliResult {
    Success { message: String, data: Option<Map<String, String>> },
    Error { message: String, code: Int },
}

let VERSION = "0.1.0";
let BANNER = `
┌──────────────────────────────────────────┐
│  git-dispatcher v${VERSION}                │
│  Git workflow dispatcher                 │
│  https://github.com/hyperpolymath        │
└──────────────────────────────────────────┘
`;

let HELP_TEXT = `
Usage: git-dispatcher <command> [options]

Commands:
  plan load <file>        Load a plan from JSON file
  plan show <plan-id>     Display plan details
  plan list              List all loaded plans
  plan validate <id>     Validate plan structure

  execute <plan-id>      Execute a plan
  execute --dry-run <id> Dry-run execution (show operations)

  status                 Show execution status for all plans
  status <plan-id>       Show status for specific plan

  audit                  Show audit log
  audit --plan <id>      Show audit log for specific plan

  help                   Show this help message
  version                Show version information
`;

fn parseArgs(args: Array<String>): Result<Command, String> {
    if args.length() == 0 {
        Ok(Command.Help)
    } else {
        match args[0] {
            "help" | "--help" | "-h" => Ok(Command.Help),
            "version" | "--version" | "-v" => Ok(Command.Version),
            "plan" => {
                if args.length() > 2 {
                    match args[1] {
                        "load" => Ok(Command.Plan { action: PlanAction.Load { path: args[2] } }),
                        "show" => Ok(Command.Plan { action: PlanAction.Show { planId: args[2] } }),
                        "validate" => Ok(Command.Plan { action: PlanAction.Validate { planId: args[2] } }),
                        _ => Err("Unknown plan action. Use: load, show, list, validate"),
                    }
                } else if args.length() > 1 && args[1] == "list" {
                    Ok(Command.Plan { action: PlanAction.List })
                } else {
                    Err("Missing arguments for plan command")
                }
            },
            "execute" => {
                let dryRun = args.contains("--dry-run");
                let planId = args.filter(|arg| arg != "--dry-run" && arg != "execute")[0];
                if planId != "" {
                    Ok(Command.Execute { planId, dryRun })
                } else {
                    Err("Missing plan-id argument for execute")
                }
            },
            "status" => {
                if args.length() > 1 {
                    Ok(Command.Status { planId: Some(args[1]) })
                } else {
                    Ok(Command.Status { planId: None })
                }
            },
            "audit" => {
                let filter = Audit.AuditFilter {
                    planId: None,
                    eventType: None,
                    startDate: None,
                    endDate: None,
                    limit: 100,
                };
                Ok(Command.Audit { filter })
            },
            cmd => Err(`Unknown command: ${cmd}`)
        }
    }
}

fn run(command: Command): CliResult {
    match command {
        Command.Help => CliResult.Success { message: HELP_TEXT, data: None },
        Command.Version => CliResult.Success { message: BANNER, data: None },
        Command.Plan { action } => {
            match action {
                PlanAction.Load { path } => CliResult.Success { message: `Would load plan from: ${path}`, data: None },
                PlanAction.Show { planId } => CliResult.Success { message: `Would show plan: ${planId}`, data: None },
                PlanAction.List => CliResult.Success { message: "Would list all plans", data: None },
                PlanAction.Validate { planId } => CliResult.Success { message: `Would validate plan: ${planId}`, data: None },
            }
        },
        Command.Execute { planId, dryRun } => {
            if dryRun {
                CliResult.Success { message: `Dry-run execution for plan: ${planId}`, data: None }
            } else {
                CliResult.Success { message: `Would execute plan: ${planId}`, data: None }
            }
        },
        Command.Status { planId } => {
            match planId {
                Some(id) => CliResult.Success { message: `Would show status for plan: ${id}`, data: None },
                None => CliResult.Success { message: "Would show status for all plans", data: None },
            }
        },
        Command.Audit { filter: _ } => {
            CliResult.Success { message: "Would show audit log", data: None }
        }
    }
}

fn main(args: Array<String>): Int {
    match parseArgs(args) {
        Ok(command) => {
            match run(command) {
                CliResult.Success { message, data: _ } => {
                    Console.log(message);
                    0
                },
                CliResult.Error { message, code } => {
                    Console.error(`Error: ${message}`);
                    code
                }
            }
        },
        Err(msg) => {
            Console.error(`Error: ${msg}`);
            Console.error("\nUse 'git-dispatcher help' for usage information");
            1
        }
    }
}
