module DocRenderer;

import Plan;

async fn findTemplates(repoPath: String): Result<Array<String>, String> {
    Console.log(`[DocRenderer] Would find templates in ${repoPath}`);
    Ok(["README.template.adoc", "docs/API.template.adoc"])
}

async fn renderTemplate(repoPath: String, templatePath: String): Result<String, String> {
    let scmDir = `${repoPath}/.machine_readable`;
    let outputPath = templatePath.replace(".template", "");
    Console.log(`[DocRenderer] Would render: ${templatePath} -> ${outputPath}`);
    Console.log(`[DocRenderer]   SCM dir: ${scmDir}`);
    Ok(outputPath)
}

async fn execute(repoPath: String, templates: Array<String>, ctx: Plan.ExecutionContext): Result<Plan.OpResult, String> {
    Console.log(`[DocRenderer] Rendering documentation for ${repoPath}`);

    let templateListResult = if templates.length() == 0 {
        await findTemplates(repoPath)
    } else {
        Ok(templates)
    };

    match templateListResult {
        Ok(templateList) => {
            let mut failures = [];
            let mut outputs = [];

            for template in templateList {
                match await renderTemplate(repoPath, template) {
                    Ok(path) => outputs.push(path),
                    Err(err) => failures.push(err),
                }
            }

            if failures.length() > 0 {
                Ok(Plan.OpResult {
                    opId: "doc-render",
                    status: Plan.ExecutionStatus.Failed { error: `Failed to render ${failures.length()} templates` },
                    startedAt: Some(Date.now().toISOString()),
                    completedAt: Some(Date.now().toISOString()),
                    output: None,
                    error: Some(failures.join(", ")),
                    metadata: Map.empty(),
                })
            } else {
                Ok(Plan.OpResult {
                    opId: "doc-render",
                    status: Plan.ExecutionStatus.Completed,
                    startedAt: Some(Date.now().toISOString()),
                    completedAt: Some(Date.now().toISOString()),
                    output: Some(`Rendered ${outputs.length()} files`),
                    error: None,
                    metadata: Map.empty(),
                })
            }
        },
        Err(err) => {
            Ok(Plan.OpResult {
                opId: "doc-render",
                status: Plan.ExecutionStatus.Failed { error: `Failed to find templates: ${err}` },
                startedAt: Some(Date.now().toISOString()),
                completedAt: Some(Date.now().toISOString()),
                output: None,
                error: Some(err),
                metadata: Map.empty(),
            })
        }
    }
}
