module Audit;

enum EventType {
    PlanLoaded,
    PlanValidated,
    ExecutionStarted,
    OperationStarted,
    OperationCompleted,
    OperationFailed,
    BotDispatched,
    BotResponseReceived,
    RollbackTriggered,
    RollbackCompleted,
    ExecutionCompleted,
    ExecutionFailed,
}

struct AuditEntry {
    id: String,
    timestamp: String,
    eventType: EventType,
    planId: String,
    operationId: Option<String>,
    botDispatchId: Option<String>,
    actor: String,
    details: Map<String, String>,
    metadata: Map<String, String>,
}

struct AuditTrace {
    traceId: String,
    planId: String,
    startedAt: String,
    completedAt: Option<String>,
    entries: Array<AuditEntry>,
    summary: Map<String, String>,
}

struct AuditFilter {
    planId: Option<String>,
    eventType: Option<EventType>,
    startDate: Option<String>,
    endDate: Option<String>,
    limit: Int,
}

fn eventTypeToString(eventType: EventType): String {
    match eventType {
        EventType.PlanLoaded => "PlanLoaded",
        EventType.PlanValidated => "PlanValidated",
        EventType.ExecutionStarted => "ExecutionStarted",
        EventType.OperationStarted => "OperationStarted",
        EventType.OperationCompleted => "OperationCompleted",
        EventType.OperationFailed => "OperationFailed",
        EventType.BotDispatched => "BotDispatched",
        EventType.BotResponseReceived => "BotResponseReceived",
        EventType.RollbackTriggered => "RollbackTriggered",
        EventType.RollbackCompleted => "RollbackCompleted",
        EventType.ExecutionCompleted => "ExecutionCompleted",
        EventType.ExecutionFailed => "ExecutionFailed",
    }
}

fn eventTypeFromString(str: String): Option<EventType> {
    match str {
        "PlanLoaded" => Some(EventType.PlanLoaded),
        "PlanValidated" => Some(EventType.PlanValidated),
        "ExecutionStarted" => Some(EventType.ExecutionStarted),
        "OperationStarted" => Some(EventType.OperationStarted),
        "OperationCompleted" => Some(EventType.OperationCompleted),
        "OperationFailed" => Some(EventType.OperationFailed),
        "BotDispatched" => Some(EventType.BotDispatched),
        "BotResponseReceived" => Some(EventType.BotResponseReceived),
        "RollbackTriggered" => Some(EventType.RollbackTriggered),
        "RollbackCompleted" => Some(EventType.RollbackCompleted),
        "ExecutionCompleted" => Some(EventType.ExecutionCompleted),
        "ExecutionFailed" => Some(EventType.ExecutionFailed),
        _ => None,
    }
}
