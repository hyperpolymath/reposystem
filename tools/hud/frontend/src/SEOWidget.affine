module SEOWidget;

struct SeoData {
    overallScore: Float,
    status: String,
    grade: String,
    repositoryUrl: String,
}

enum Msg {
    Analyze { repoUrl: String }
}

fn view(data: Option<SeoData>, onAnalyze: fn(String) -> Unit): Element {
    match data {
        None => {
            <div class="seo-widget-empty">
                <h3>Repository SEO</h3>
                <p>No SEO data available.</p>
            </div>
        },
        Some(r) => {
            <div class="seo-widget">
                <h3>Repository SEO</h3>
                <button onClick={|| onAnalyze(r.repositoryUrl)}>Refresh</button>
                <div class="seo-score">
                    {r.overallScore.toString()} / 100
                </div>
            </div>
        }
    }
}
