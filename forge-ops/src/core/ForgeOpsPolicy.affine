module ForgeOpsPolicy;

import ForgeOpsEngine;
import ForgeOpsModel;

fn enabledConstraints(): Array<ForgeOpsModel.PolicyConstraint> {
    ForgeOpsModel.DEFAULT_CONSTRAINTS.filter(|c| c.enabled)
}

fn constraintsByCategory(cat: ForgeOpsModel.ForgeCategory): Array<ForgeOpsModel.PolicyConstraint> {
    ForgeOpsModel.DEFAULT_CONSTRAINTS.filter(|c| c.category == cat)
}

fn findConstraint(id: String): Option<ForgeOpsModel.PolicyConstraint> {
    ForgeOpsModel.DEFAULT_CONSTRAINTS.find(|c| c.id == id)
}

fn auditSettings(repoName: String, settings: Array<ForgeOpsModel.ForgeSetting>): ForgeOpsModel.AuditResult {
    // Audit implementation
    ForgeOpsModel.AuditResult {
        timestamp: "now",
        repos: [repoName],
        findings: [],
        passed: 0,
        failed: 0,
        warnings: 0,
        score: 1.0,
    }
}
